# Copy this file to `.env.local` for local development.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# NEVER commit real values. Variables starting with NEXT_PUBLIC_ are visible in the browser.

# Which environment this is: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Full URL of this site, no trailing slash. Local: http://localhost:3000 · Vercel: https://maximusnjcom.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server only, never in browser code. Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# SECRET — local scripts only (npm run db:push / db:test / db:types). NOT needed on Vercel.
# Supabase → Connect → Connection string → URI (with your database password filled in)
SUPABASE_DB_URL=
