# Copy this file to `.env.local` for local development.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# NEVER commit real values. Variables starting with NEXT_PUBLIC_ are visible in the browser.

# Which environment this is: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Supabase (added in Step 1) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
